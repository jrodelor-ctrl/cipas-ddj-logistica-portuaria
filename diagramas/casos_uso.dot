subgraph cluster_s {label="Sistema de Analítica Portuaria";color="#b88b2f";style=rounded; upload [shape=ellipse,label="Cargar CSV"]; limpiar [shape=ellipse,label="Validar y depurar registros"]; filtrar[shape=ellipse,label="Filtrar tipo de carga y clima"]; kpi[shape=ellipse,label="Consultar indicadores KPI"]; comparar[shape=ellipse,label="Analizar tendencias y demoras"];alertar[shape=ellipse,label="Revisar alertas críticas"];exportar[shape=ellipse,label="Exportar datos y auditoría"];}
